; Open with Godot 4.7.2 stable (standard / GDScript edition).
config_version=5

[application]
; Keep the Phase 0 identity so native and browser user:// saves retain their path.
config/name="Chronicles of Aetheria — Phase 0"
config/description="Mechanical Citadel: combat training sector."
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Controls="*res://scripts/platform/input_adapter.gd"
Visuals="*res://scripts/presentation/visual_settings.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=640
window/size/min_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=60

[layer_names]
2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Progression triggers"
2d_physics/layer_4="Enemies"
2d_physics/layer_5="Hostile projectiles"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.09, 1)
